# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# --- Binacore (bloc B1) ---
# .env* ci-dessus ignore aussi .env.example : on le re-inclut explicitement,
# il fait partie du livrable et doit rester versionne.
!.env.example

# client Prisma genere (cf. output dans prisma/schema.prisma)
/lib/generated

# sauvegardes locales
backups/

# config locale Claude Code (jamais versionnee)
.claude/settings.local.json

# Espace de travail des plans superpowers (scratch, jamais versionne).
.superpowers/
