// Enveloppe v7 etablie au bloc B1 : provider "prisma-client", output hors de app/,
// URL de connexion dans prisma.config.ts (imposee par Prisma 7, cf. P1012).
// Modeles ajoutes au bloc B2.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PriceType {
  FIXED
  FROM
  QUOTE
}

enum LeadSource {
  FORM
  CHATBOT
  WHATSAPP
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

model Service {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  // La version anglaise du catalogue. NULLABLE ET C EST LA REGLE : tant qu une
  // ligne n est pas traduite, le site anglais retombe sur le francais plutot
  // que d afficher un trou. Une traduction absente se voit et se corrige ;
  // une chaine vide passe inapercue jusqu au client.
  // Les NOMS DES TROIS FORMULES ne se traduisent PAS — docs/agents/brand/
  // voice-guide.md §10 : « jamais abregees, jamais traduites ». La Vitrine
  // reste La Vitrine. (Citation corrigee le 31/08 : elle renvoyait a tort
  // vers product-marketing.md §8, ou la regle ne figure pas.)
  // Pour elles, nameEn reste null volontairement.
  nameEn        String?
  descriptionEn String?
  category    String
  priceType   PriceType
  priceCents  Int?
  priceFrom   Boolean   @default(false)
  isMonthly   Boolean   @default(false)
  visible     Boolean   @default(true)
  sortOrder   Int       @default(0)
}

model Lead {
  id            String        @id @default(cuid())
  name          String
  // NULLABLE depuis b13, et c est une correction, pas un assouplissement.
  // Le formulaire demande « un telephone OU un e-mail » — c est son .refine()
  // final (app/api/contact/route.ts) qui impose l un des deux. La colonne,
  // elle, etait NOT NULL : quand le visiteur ne laissait que son e-mail, la
  // route ecrivait une CHAINE VIDE. Deux consequences visibles, toutes deux
  // constatees : /admin affichait une cellule vide sous un lien wa.me pointant
  // sur https://wa.me/ — un numero qui n existe pas —, et la notification
  // Telegram annoncait un contact qu Ayoub ne pouvait pas rappeler.
  // Un champ vide en base se lit tout de suite comme « on ne sait pas » ;
  // une chaine vide se lit comme un bug. Meme raison que `email` juste dessous.
  phone         String?
  email         String?
  commerceName  String?
  commerceType  String?
  source        LeadSource
  status        LeadStatus    @default(NEW)
  score         Int           @default(0)
  needSummary   String?
  // Ce qui a ete demande, quand on le sait : le slug d une formule ou d une
  // prestation (« le-site », « devis-identite »), pose par la page /devis.
  // Ajoute parce que la table ne gardait AUCUNE trace de l intention : un
  // visiteur cliquait « Le Site » et la demande arrivait nue, il fallait le
  // rappeler pour savoir de quoi il parlait. Le modele extrait deja un
  // tableau `services` cote chatbot (lib/extract-prompt.ts), mais il finissait
  // dans Conversation.extracted, invisible du back-office.
  // Nullable, et c est voulu : une demande spontanee — pied de page, WhatsApp
  // — n en porte pas, et un champ vide vaut mieux qu un champ invente.
  subject       String?
  notes         String?
  conversation  Conversation?
  createdAt     DateTime      @default(now())
}

model Conversation {
  id        String   @id @default(cuid())
  // Identifiant de session du widget, pose au bloc B10. UNIQUE : c est lui qui
  // rend la finalisation idempotente. Le widget peut appeler /api/chat/finalize
  // deux fois — bouton « Terminer » puis pagehide, ou un sendBeacon rejoue — et
  // la seconde tentative doit repartir sans rien ecrire.
  // Nullable : les conversations d avant B10 n en ont pas, et @unique tolere
  // plusieurs NULL en PostgreSQL.
  sessionId String?  @unique
  lead      Lead?    @relation(fields: [leadId], references: [id])
  leadId    String?  @unique
  messages  Json
  summary   String?
  extracted Json?
  ipHash    String
  createdAt DateTime @default(now())
}

// Bloc B8 : limitation de debit du formulaire de contact.
// Une ligne = une tentative acceptee. Le comptage se fait sur une fenetre
// glissante (ipHash + action + createdAt), d ou l index composite.
// Jamais d IP en clair : ipHash est un sha256(ip + IP_HASH_SALT), coherent
// avec Conversation.ipHash pose au bloc B2.
model RateLimit {
  id        String   @id @default(cuid())
  ipHash    String
  action    String
  createdAt DateTime @default(now())

  @@index([ipHash, action, createdAt])
}
