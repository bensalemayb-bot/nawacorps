# --- Base de donnees ---
DB_PASSWORD=
DATABASE_URL=

# --- Application ---
NEXT_PUBLIC_SITE_URL=
DOMAIN=

# --- Notification Telegram (bloc B8) ---
# Token donne par @BotFather. Si l une des deux cles est vide, la notification
# est simplement sautee : elle n empeche jamais l enregistrement du lead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Confidentialite ---
# Sel du hachage des IP. Jamais d IP en clair en base.
# Generer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# --- Chatbot de qualification (bloc B9) ---
# Vue d ensemble, plafonds des fournisseurs et protocole de sonde :
# docs/chatbot.md. Diagnostic en ligne : GET /api/health/chat (admin requis).
#
# Cle de l API Gemini (Google AI Studio). Si elle est absente, l assistant
# repond indisponible et l UI renvoie vers le formulaire : jamais d erreur nue.
# QUOTA GRATUIT : 20 requetes PAR MODELE ET PAR JOUR. Un 429 en boucle veut
# rarement dire « cle morte » — le plus souvent, ce modele-la a fini sa
# journee, et il faudra attendre le lendemain.
GEMINI_API_KEY=
# Plafond global de requetes au modele sur 24 h glissantes, tous visiteurs
# confondus. Les quotas gratuits de Google sont limites PAR MINUTE ET PAR JOUR
# et ne sont pas lisibles depuis l application : ce compteur local est une
# ceinture, pas un miroir du quota Google. Au-dela, comme au dela du quota
# Google, le repli formulaire prend le relais.
CHAT_DAILY_LIMIT=200

# --- Fournisseur LLM (bloc B10b) ---
# Quel fournisseur sert askLlm et askLlmJson : "gemini", "groq" ou "infomaniak".
# ABSENT OU VIDE = gemini, c est-a-dire le comportement d avant ce bloc.
# Basculer ne demande que cette ligne : aucun appelant ne connait le
# fournisseur, tout est confine dans lib/llm.ts (decision B9).
LLM_PROVIDER=
# Cle de l API Groq (console.groq.com). Lue UNIQUEMENT si LLM_PROVIDER=groq.
# Meme contrat que Gemini : si elle est absente, l assistant repond
# indisponible et l UI renvoie vers le formulaire — jamais d erreur nue.
# PLAFOND : ~6 requetes par minute, tous visiteurs confondus. C est une limite
# en TOKENS par minute (8000 en tier on_demand) qui compte l entree plus les
# max_tokens reserves. A l inverse de Gemini, le budget revient tout seul a la
# minute suivante.
GROQ_API_KEY=

# --- Infomaniak AI Tools : modeles heberges en Suisse, offre payante ---
# Pour LLM_PROVIDER=infomaniak (lib/llm.ts). C est le fournisseur a utiliser
# pour les assistants VENDUS aux clients (promesse « donnees en Suisse »).
# Jeton API avec le scope ai-tools (Manager Infomaniak > Profil > Jetons API).
INFOMANIAK_AI_TOKEN=
# Manager > Cloud Computing > AI Tools : identifiant du produit.
INFOMANIAK_AI_PRODUCT_ID=
# Nom exact du modele, tel que liste dans AI Tools.
INFOMANIAK_AI_MODEL=
# Optionnel : URL de base si Infomaniak change la version du chemin (/1/, /2/).
INFOMANIAK_AI_BASE_URL=

# --- Administration (bloc B11) ---
# Mot de passe de /admin. Il vit ICI et nulle part ailleurs — jamais en base,
# jamais hache en dur dans le code. Le changer ne demande qu un redemarrage.
ADMIN_PASSWORD=
# Cle de signature HMAC-SHA256 du cookie de session admin. Sans rapport avec
# le mot de passe : la changer invalide toutes les sessions ouvertes, ce qui
# est le moyen de deconnecter tout le monde d un coup.
# Generer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=
